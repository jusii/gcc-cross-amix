-m68060: 68040 code without the 32x32->64-bit multiply (MULU.L/MULS.L <ea>,Dh:Dl) the 68060 does not implement; constant divides use the 32-bit divide.

--- a/config/m68k/m68k.h
+++ b/config/m68k/m68k.h
@@ -93,6 +93,12 @@
 /* Use the 68040-only fp instructions (-m68040).  */
 #define TARGET_68040_ONLY (target_flags & 01000)
 
+/* Compile for a 68060 (-m68060): code as for the 68040, but without the
+   32x32->64-bit multiply MULU.L/MULS.L <ea>,Dh:Dl, which the 68060 does not
+   implement (it traps to vector 61).  Divides and modulos by a constant are
+   then done with the 32-bit divide instead of a multiply by the reciprocal.  */
+#define TARGET_68060 (target_flags & 02000)
+
