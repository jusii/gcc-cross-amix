gcc driver and cpp: use strerror(); modern C libraries no longer export sys_nerr/sys_errlist.

--- a/cccp.c
+++ b/cccp.c
@@ -38,6 +38,8 @@
    for the sake of machines with limited C compilers.  */
 #ifndef EMACS
 #include "config.h"
+/* amix-cross: modern libc strerror fallback. */
+#include <string.h>
 #endif /* not EMACS */
 
